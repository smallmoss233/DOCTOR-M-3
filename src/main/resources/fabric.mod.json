{
	"schemaVersion": 1,
	"id": "doctor_m",
	"version": "${version}",
	"name": "DOCTOR M",
	"description": "新一代 Doctor Who 模组！",
	"authors": [
		"Small Moss / 核心开发者"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/doctor_m/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"doctor_m.DOCTOR_M"
		],
		"client": [
			"doctor_m.client.DOCTOR_MClient"
		],
        "fabric-datagen": [
          "doctor_m.client.DOCTORMDataGenerator"
        ]
	},
	"mixins": [
      "mosslib.mixins.json",
      "doctor_m.mixins.json",
      {
			"config": "doctor_m.client.mixins.json",
			"environment": "client"
      }
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}